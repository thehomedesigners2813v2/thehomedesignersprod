# Local Supabase. Copy to .env. Do not commit .env.
# After `npx supabase start`, copy the anon key from `npx supabase status`.
# Private keys (Resend, Razorpay, Gemini, OpenAI) belong in supabase/.env, never in VITE_ variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
