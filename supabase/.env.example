# Copy to supabase/functions/.env. That file is gitignored.
# `npx supabase start` loads supabase/functions/.env into Edge Functions.
# It also injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Do not put private keys in frontend VITE_ variables.
# Leave a value empty until you have a development credential. Do not use production keys.

# Resend development key. https://resend.com/api-keys
# The existing functions send from orders@thehomedesigners.com, which must be a verified Resend domain.
RESEND_API_KEY=

# Razorpay Test Mode only. https://dashboard.razorpay.com/app/keys
# Use the Test Key ID and Test Key Secret. Never the Live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from a Razorpay test webhook pointing at
# http://127.0.0.1:54321/functions/v1/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=

# Google AI Studio key for gemini-chat and vastu-analysis. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AI quotation jobs use OpenAI, not Gemini. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# WhatsApp is implemented with WAHA, not the Meta Cloud API.
# Put the local WAHA URL in the whatsapp_settings table (waha_api_url, waha_session, waha_api_key).
# Do not place a WAHA or Meta token in a VITE_ variable.
